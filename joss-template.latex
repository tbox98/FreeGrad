\documentclass[11pt,a4paper]{article}

\usepackage[utf8]{inputenc}
\usepackage{hyperref}
\usepackage{geometry}
\geometry{margin=1in}
\usepackage{calc}

% --- Add these packages for highlighting support ---
\usepackage{color}
\usepackage{fancyvrb}
%\newcommand{\VerbBar}{|}
%\newcommand{\VERB}{\Verb[commandchars=\\\{\}]}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{commandchars=\\\{\}}
% Add framed for the background shading
\usepackage{framed}
\definecolor{shadecolor}{RGB}{248,248,248}

% --- Inject Pandoc Highlighting Macros ---
$if(highlighting-macros)$
$highlighting-macros$
$endif$

% --- Fix for Pandoc tight lists ---
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}%
}

% =========================================
% --- CSL / Citeproc Configuration ---
% =========================================

% 1. Define standard lengths
\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{0pt}
\newlength{\cslentryspacingunit}
\setlength{\cslentryspacingunit}{\parskip}

% 2. CSS-like commands (just in case Pandoc emits them)
\newcommand{\CSLLeftMargin}[1]{}
\newcommand{\CSLRightInline}[1]{#1}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}
\newcommand{\CSLBlock}[1]{#1\hfill\break}

% 3. The CSLReferences Environment
%    - Forces a list structure to handle hanging indents.
%    - Explicitly hides any labels (the [] you see).
\newenvironment{CSLReferences}[2]
 {%
  \begin{list}{}{%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    % Ensure labels take up NO space
    \setlength{\labelwidth}{0pt}%
    \setlength{\labelsep}{0pt}%
    \setlength{\leftmargin}{0pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\itemsep}{#2\baselineskip}%
    %
    % Hanging Indent Logic
    \setlength{\leftmargin}{0pt}%
    \setlength{\itemindent}{0pt}%
    %
    % CRITICAL FIX: Force labels to be empty
    % This removes the [] or numbers completely.
    \renewcommand{\makelabel}[1]{}%
  }%
 }%
 {\end{list}}

% 4. Robust definition for citeproctext to prevent errors
\makeatletter
\DeclareRobustCommand{\citeproctext}[1][]{#1}
\makeatother

% =========================================
% --- YAML Headers ---
% =========================================
\makeatletter
\newcommand{\printauthors}{%
$for(authors)$%
$authors.name$$if(authors.orcid)$ (\href{https://orcid.org/$authors.orcid$}{ORCID})$endif$$if(authors.affiliation)$\textsuperscript{$authors.affiliation$}$endif$$sep$, %
$endfor$%
}
\newcommand{\printaffiliations}{%
$for(affiliations)$%
\textsuperscript{$affiliations.index$}$affiliations.name$\\%
$endfor$%
}
\makeatother

% =========================================
% --- Document ---
% =========================================
\title{$title$}
\author{\printauthors}
\date{$date$}

\begin{document}
\maketitle

\begin{center}
\printaffiliations
\end{center}

$body$

\end{document}
