\documentclass[11pt,a4paper]{article}

\usepackage[utf8]{inputenc}
\usepackage{hyperref}
\usepackage{geometry}
\geometry{margin=1in}

% --- Fix for Pandoc tight lists ---
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}%
}

% --- CSL / citeproc support (Pandoc) ---
% Hanging indent & spacing for references (we keep lengths, but won't use hanging)
\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\cslentryspacingunit}
\setlength{\cslentryspacingunit}{0.5\baselineskip}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{3em}

\newenvironment{CSLReferences}[2] % #1 hanging-indent, #2 entry spacing
 {%
  % no paragraph indentation
  \setlength{\parindent}{0pt}%
  % no hanging indent at all: ignore #1
  % fixed extra space between entries
  \setlength{\parskip}{0.5\baselineskip}%
 }%
 {\par}

\usepackage{calc}

% Each reference block: just start a new line/paragraph
\newcommand{\CSLBlock}[1]{#1\par}

% Label (e.g. [1]) followed by a small space, no special indentation
\newcommand{\CSLLeftMargin}[1]{#1\ }

% Main reference text inline; normal line wrapping (no extra indent)
\newcommand{\CSLRightInline}[1]{#1}

% Indent helper (rarely used by pandoc, but keep it simple)
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}

% --- Robust no-op for \citeproctext (emitted by citeproc) ---
\makeatletter
\DeclareRobustCommand{\citeproctext}[1][]{#1}
\makeatother

% ===== Helpers to print authors & affiliations from YAML =====
\makeatletter
\newcommand{\printauthors}{%
$for(authors)$%
$authors.name$$if(authors.orcid)$ (\href{https://orcid.org/$authors.orcid$}{ORCID})$endif$$if(authors.affiliation)$\textsuperscript{$authors.affiliation$}$endif$$sep$, %
$endfor$%
}
\newcommand{\printaffiliations}{%
$for(affiliations)$%
\textsuperscript{$affiliations.index$}$affiliations.name$\\%
$endfor$%
}
\makeatother

% ===== Title block =====
\title{$title$}
\author{\printauthors}
\date{$date$}

\begin{document}
\maketitle

\begin{center}
\printaffiliations
\end{center}

$body$

\end{document}
